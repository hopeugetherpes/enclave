{
  "name": "enclave",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:offline && pnpm run harden:web",
    "build:web": "NEXT_TELEMETRY_DISABLED=1 next build",
    "build:offline": "node scripts/build-offline.mjs",
    "harden:web": "node scripts/harden-web.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev": "next dev"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "libsodium-wrappers-sumo": "0.8.4",
    "lucide-react": "0.577.0",
    "next": "16.3.4",
    "openpgp": "6.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "5.9.2"
  }
}
